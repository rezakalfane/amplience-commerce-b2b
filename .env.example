# Copy to .env.local and fill in. Never commit real values.

# --- Amplience (delivery, read only; no secret needed) ----------------------
AMPLIENCE_HUB_NAME=commercedemo
# Which content the deployment reads:
#   production -> <hub>.cdn.content.amplience.net      (published content; the default when unset)
#   preview    -> <id>.staging.bigcontent.io           (virtual staging: latest saved content; enables /preview)
AMPLIENCE_DELIVERY_HOST=
# Preview deployments only: the middle part of a time-pinned staging domain, used by `?time=` and the time preview banner.
# Open any preview app once from Scheduling; its domain looks like <id>-<TOKEN>-<unix ms>.staging.bigcontent.io
AMPLIENCE_TIME_TOKEN=

# --- Amplience (management; seeding scripts only, never used by the storefront) ---
AMPLIENCE_PAT=                         # personal access token
AMPLIENCE_HUB_ID=                      # Management API hub id

# --- BigCommerce (Storefront GraphQL, channel-scoped token) -----------------
BIGCOMMERCE_STORE_HASH=
BIGCOMMERCE_CHANNEL_ID=
BIGCOMMERCE_STOREFRONT_TOKEN=          # created per origin (http://localhost:3000, production domain)
